.avatar-container {
  --frame-color: transparent;
}

.avatar-frame {
  position: relative;
  width: 100%;
  height: 100%;

  &.has-frame {
    padding: 2px;
    background: var(--frame-color);

    &.frame-animated {
      animation: frame-pulse 2s ease-in-out infinite;
    }
  }
}

.avatar-inner {
  position: relative;
  z-index: 1;
}

.effect-overlay {
  z-index: 2;

  &[data-effect="sparkle"] {
    background: radial-gradient(circle, transparent 40%, rgba(255, 215, 0, 0.15) 100%);
    animation: sparkle 2s ease-in-out infinite;
  }

  &[data-effect="fire"] {
    box-shadow: 0 0 8px rgba(255, 100, 0, 0.6);
    animation: fire-glow 1s ease-in-out infinite alternate;
  }

  &[data-effect="ice"] {
    box-shadow: 0 0 8px rgba(100, 200, 255, 0.6);
  }

  &[data-effect="rainbow"] {
    background: conic-gradient(
      from 0deg,
      rgba(255, 0, 0, 0.15),
      rgba(255, 127, 0, 0.15),
      rgba(255, 255, 0, 0.15),
      rgba(0, 255, 0, 0.15),
      rgba(0, 0, 255, 0.15),
      rgba(139, 0, 255, 0.15),
      rgba(255, 0, 0, 0.15)
    );
    animation: rainbow-rotate 4s linear infinite;
  }

  &[data-effect="galaxy"] {
    background: radial-gradient(ellipse at center, rgba(100, 0, 200, 0.25) 0%, transparent 70%);
    animation: galaxy-pulse 3s ease-in-out infinite;
  }

  &[data-effect="lightning"] {
    box-shadow: 0 0 10px rgba(255, 255, 100, 0.7);
    animation: lightning-flash 0.5s ease-in-out infinite;
  }

  &[data-effect="hearts"] {
    &::before {
      content: '❤️';
      position: absolute;
      font-size: 0.5em;
      animation: float-heart 2s ease-in-out infinite;
    }
  }
}

@keyframes frame-pulse {
  0%, 100% {
    box-shadow: 0 0 0 0 var(--frame-color);
  }
  50% {
    box-shadow: 0 0 10px 2px var(--frame-color);
  }
}

@keyframes sparkle {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 1;
    transform: scale(1.02);
  }
}

@keyframes fire-glow {
  0% {
    box-shadow: 0 0 6px rgba(255, 100, 0, 0.5);
  }
  100% {
    box-shadow: 0 0 12px rgba(255, 150, 50, 0.8);
  }
}

@keyframes rainbow-rotate {
  0% {
    transform: rotate(0deg);
  }
  100% {
    transform: rotate(360deg);
  }
}

@keyframes galaxy-pulse {
  0%, 100% {
    opacity: 0.5;
    transform: scale(1);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

@keyframes lightning-flash {
  0%, 90%, 100% {
    opacity: 0.3;
  }
  95% {
    opacity: 1;
  }
}

@keyframes float-heart {
  0% {
    transform: translateY(0) scale(1);
    opacity: 1;
  }
  100% {
    transform: translateY(-20px) scale(0.5);
    opacity: 0;
  }
}

// Badge positioning for different sizes
.avatar-badge {
  z-index: 3;
}

.status-indicator {
  z-index: 3;
}
