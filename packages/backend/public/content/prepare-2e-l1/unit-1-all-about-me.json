          "header": {
            "title": "GRAMMAR",
            "subtitle": "be (present simple)",
            "color": "purple"
          },
          "grammarBox": {
            "title": "be - present simple",
            "tables": [
              {
                "type": "conjugation",
                "headers": ["Affirmative", "Negative", "Question"],
                "rows": [
                  ["I am / I'm", "I am not / I'm not", "Am I...?"],
                  ["You are / You're", "You are not / You aren't", "Are you...?"],
                  ["He is / He's", "He is not / He isn't", "Is he...?"],
                  ["She is / She's", "She is not / She isn't", "Is she...?"],
                  ["It is / It's", "It is not / It isn't", "Is it...?"],
                  ["We are / We're", "We are not / We aren't", "Are we...?"],
                  ["They are / They're", "They are not / They aren't", "Are they...?"]
                ]
              }
            ],
            "notes": [
              "Use 'be' to talk about names, ages, nationalities, and feelings.",
              "Short forms: I'm, you're, he's, she's, it's, we're, they're",
              "Negative short forms: isn't, aren't"
            ]
          },
