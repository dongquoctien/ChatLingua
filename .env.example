# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=chatlingua
DB_PASSWORD=chatlingua_pass
DB_NAME=chatlingua

# JWT Configuration (for backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h

# Backend Server
BACKEND_PORT=3000

# Frontend
FRONTEND_PORT=4200

# ===== Docker Production Configuration =====
# MySQL (for docker-compose.prod.yml)
MYSQL_ROOT_PASSWORD=chatlingua_root
MYSQL_DATABASE=chatlingua
MYSQL_USER=chatlingua
MYSQL_PASSWORD=chatlingua_pass

# Backend CORS
CORS_ORIGIN=http://localhost

# Exposed port for frontend
PORT=80
